APP_NAME=Agentic Customer Service Platform
APP_ENV=development
DEBUG=false
# LOCAL DEMO ONLY: deterministic, non-secret localhost credential. Replace this entire
# auth mode for production; never reuse this value as a production credential.
AUTH_MODE=local_demo
LOCAL_DEMO_AUTH_TOKEN=local-demo-support-token
LOCAL_DEMO_ACTOR_ID=operator-local-demo
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/customer_service
LLM_MODEL=llama3.1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
# Backend containers use this address to reach an OpenAI-compatible LLM on the host.
COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_TIMEOUT_SECONDS=30.0
CONFIRMATION_TTL_SECONDS=300
RAG_BACKEND=qdrant
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=32
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANKER_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=customer_service_knowledge
RAG_DENSE_TOP_K=8
RAG_SPARSE_TOP_K=8
RAG_RERANK_CANDIDATES=12
RAG_FINAL_CONTEXT_COUNT=4
RAG_CHUNK_SIZE=800
RAG_RERANKER_TIMEOUT_SECONDS=3.0
QDRANT_TIMEOUT_SECONDS=10.0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-customer-service-platform
MEMORY_ENABLED=true
MEMORY_MAX_CONTEXT_ITEMS=5
MEMORY_DEFAULT_TTL_DAYS=365
MEMORY_SUPPORT_CONTEXT_TTL_DAYS=30
RESILIENCE_ENABLED=true
RESILIENCE_MAX_RETRIES=2
RESILIENCE_INITIAL_BACKOFF_MS=100
RESILIENCE_MAX_BACKOFF_MS=500
RETRIEVAL_TIMEOUT_SECONDS=5.0
TOOL_TIMEOUT_SECONDS=10.0
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_QUERY_TIMEOUT_SECONDS=10.0
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Used only by AUTH_MODE=static. Supply real opaque values through deployment secret
# management; static bearer auth is an integration boundary, not production IAM.
AUTH_TOKENS_JSON={}
CHECKPOINT_BACKEND=postgres
# Strict reconstruction is the default for local Compose and is mandatory in integration/production.
LANGGRAPH_STRICT_MSGPACK=true
